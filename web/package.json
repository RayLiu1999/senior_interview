{
  "name": "senior-interview-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.0",
  "scripts": {
    "content:generate": "node ../scripts/generate_web_content.mjs",
    "dev": "pnpm content:generate && nuxt dev",
    "build": "pnpm content:generate && nuxt build",
    "generate": "pnpm content:generate && nuxt generate",
    "preview": "pnpm build && node .output/server/index.mjs",
    "e2e": "playwright test",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --config ../vitest.config.ts",
    "test:watch": "vitest --config ../vitest.config.ts"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "markdown-it": "^14.1.0",
    "nuxt": "^3.17.5",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.2.0",
    "@playwright/test": "^1.62.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^16.7.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.9",
    "vue-tsc": "^2.2.8"
  }
}
